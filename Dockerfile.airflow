FROM apache/airflow:2.9.3-python3.11

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl vim python3-venv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow

WORKDIR /opt/airflow

# dbt lives in its OWN virtualenv, separate from Airflow's Python env.
# This avoids dependency clashes between Airflow's pinned packages
# (Flask, Jinja2, click, etc.) and dbt-core's own requirements.

COPY requirements.txt /requirements.txt

RUN python3 -m venv /home/airflow/dbt_venv && \
    /home/airflow/dbt_venv/bin/pip install --no-cache-dir --upgrade pip && \
    /home/airflow/dbt_venv/bin/pip install --no-cache-dir -r /requirements.txt